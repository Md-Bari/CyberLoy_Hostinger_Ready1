APP_NAME="CyberLoy LMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
# Local development default. Replace with your HTTPS API URL when deploying.
APP_URL=http://127.0.0.1:8010

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cyberloy_lms
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

FRONTEND_URL=https://yourdomain.com
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=no-reply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"
AUTH_REQUIRE_EMAIL_VERIFICATION=true

# Configure Stripe from the Stripe dashboard; never expose these in the frontend.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

SANCTUM_STATEFUL_DOMAINS=yourdomain.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:3035,http://localhost:3000,http://localhost:5173,http://127.0.0.1:3035,http://127.0.0.1:3000,http://127.0.0.1:5173
